WEB_PORT=8080

# Web admin login
WEB_USERNAME=admin
WEB_PASSWORD=change-me

# Telegram bot token. Do not use a token that is already used by AstrBot polling.
TELEGRAM_BOT_TOKEN=
BOT_ENABLED=true

# Existing Guangya resource API
GUANGYA_API_BASE=http://127.0.0.1:8000
GUANGYA_API_KEY=

# Search behavior
PAGE_SIZE=10
MAX_RESULTS=0
SEARCH_STATUS=
REQUEST_TIMEOUT_SECONDS=20
